# Copy to .env.local and fill in from Supabase → Project Settings → API.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…) or the legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role key. Server-side only: used by scripts/invite-member.mjs.
# Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Origin used in sign-in emails. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
